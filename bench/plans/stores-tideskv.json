    {
     "key_dist": "uniform"
    },
    {
     "key_dist": "zipfian:0.99"
    },
    {
     "key_dist": "hotspot:0.1:0.9"
    },
    {
     "key_dist": "normal:0.5:0.05"
    },
    {
     "key_dist": "uniform",
     "rate": 50000
    },
    {
     "key_dist": "zipfian:0.99",
     "rate": 50000
    }
   ],
   "env": {
    "TIDESKV_OPTS": "compression=zstd"
   }
  },
